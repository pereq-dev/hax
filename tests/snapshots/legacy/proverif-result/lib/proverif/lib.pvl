(*
  Run with:
    proverif -lib <hax>/hax-lib/proof-libs/proverif/primitives.pvl \
             -lib <hax>/hax-lib/proof-libs/proverif/result.pvl \
             -lib <hax>/hax-lib/proof-libs/proverif/cryptolib.pvl  \
             -lib missingdecl.pvl \
             -lib lib.pvl your_analysis.pv

  These libraries ship with hax.

  primitives.pvl declares the symbols this file uses but does not
  define: the public channel c, the construct_fail sink,
  bitstring_default and bitstring_err, the Some/None and True/False
  constructors, the nat_0 to nat_16 literal constants, and the
  rust_primitives, core, and hax_lib helpers.

  result.pvl models Result and its methods.
  This model was extracted without --result-errors: a Result is its
  Ok payload and producing an Err ends the trace, so error paths are
  pruned from the model.

  cryptolib.pvl is the shared Dolev-Yao crypto model (hash, AEAD,
  KDF, DH, KEM, signatures, MAC, serialization) that a crate wires
  itself to with #[hax_lib::proverif::replace_body("crypto__...")].
  It is needed whenever the crate does so, and harmless otherwise.

  missingdecl.pvl, extracted next to this file, declares every symbol
  this file uses that none of these libraries defines, such as string
  literals and integer literals above 16. Each is left abstract:
  replace its declaration by a definition — by hand or from another
  crate's extraction — or keep it as an ideal-functionality boundary.
*)

(* Only typechecks with result.pvl loaded. *)
letfun hax_result_model_check__new_tests() = hax_result_model__result.

(* src: src/legacy/proverif-result/lib.rs:7:0-10:1 new_tests__legacy__proverif_result__lib__Error *)
fun new_tests__legacy__proverif_result__lib__Error__Invalid(): bitstring [data].
fun new_tests__legacy__proverif_result__lib__Error__Other(): bitstring [data].
(* src: src/legacy/proverif-result/lib.rs:7:0-10:1 new_tests__legacy__proverif_result__lib__Error_cast_to_repr *)
letfun new_tests__legacy__proverif_result__lib__Error_cast_to_repr(x: bitstring) =
  let new_tests__legacy__proverif_result__lib__Error__Invalid() = x in nat_0
  else let new_tests__legacy__proverif_result__lib__Error__Other() = x in nat_1
  else bitstring_err().
(* src: src/legacy/proverif-result/lib.rs:12:0-14:1 new_tests__legacy__proverif_result__lib__check *)
letfun new_tests__legacy__proverif_result__lib__check(x: bitstring) =
  let hax__cond0 = rust_primitives__hax__machine_int__eq(x, nat_0) in
  let (=True()) = hax__cond0 in bitstring_err() else x.
(* src: src/legacy/proverif-result/lib.rs:16:0-19:1 new_tests__legacy__proverif_result__lib__question_mark *)
letfun new_tests__legacy__proverif_result__lib__question_mark(x: bitstring) =
  let hax__scrut0 = new_tests__legacy__proverif_result__lib__check(x) in
  let y = hax__scrut0 in y.
(* src: src/legacy/proverif-result/lib.rs:21:0-27:1 new_tests__legacy__proverif_result__lib__err_arms_first *)
letfun new_tests__legacy__proverif_result__lib__err_arms_first(r: bitstring) = let v = r in v.
(* src: src/legacy/proverif-result/lib.rs:29:0-35:1 new_tests__legacy__proverif_result__lib__nested_err *)
letfun new_tests__legacy__proverif_result__lib__nested_err(o: bitstring) =
  let Some(v) = o in v
  else let None() = o in nat_1
  else bitstring_err().
(* src: src/legacy/proverif-result/lib.rs:37:0-39:1 new_tests__legacy__proverif_result__lib__is_ok *)
letfun new_tests__legacy__proverif_result__lib__is_ok(r: bitstring) = core__result__Impl__is_ok(r).
(* src: src/legacy/proverif-result/lib.rs:41:0-43:1 new_tests__legacy__proverif_result__lib__map_err *)
letfun new_tests__legacy__proverif_result__lib__map_err(r: bitstring) = let hax__ok = r in hax__ok.
(* src: src/legacy/proverif-result/lib.rs:46:0-48:1 new_tests__legacy__proverif_result__lib__transpose *)
letfun new_tests__legacy__proverif_result__lib__transpose(x: bitstring) =
  core__option__Impl_4__transpose(x).