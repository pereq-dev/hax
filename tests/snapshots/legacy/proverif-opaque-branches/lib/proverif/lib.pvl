(*
  Run with:
    proverif -lib <hax>/hax-lib/proof-libs/proverif/primitives.pvl \
             -lib <hax>/hax-lib/proof-libs/proverif/result.pvl \
             -lib <hax>/hax-lib/proof-libs/proverif/cryptolib.pvl  \
             -lib missingdecl.pvl \
             -lib lib.pvl your_analysis.pv

  These libraries ship with hax.

  primitives.pvl declares the symbols this file uses but does not
  define: the public channel c, the construct_fail sink,
  bitstring_default and bitstring_err, the Some/None and True/False
  constructors, the nat_0 to nat_16 literal constants, and the
  rust_primitives, core, and hax_lib helpers.

  result.pvl models Result and its methods.
  This model was extracted without --result-errors: a Result is its
  Ok payload and producing an Err ends the trace, so error paths are
  pruned from the model.

  cryptolib.pvl is the shared Dolev-Yao crypto model (hash, AEAD,
  KDF, DH, KEM, signatures, MAC, serialization) that a crate wires
  itself to with #[hax_lib::proverif::replace_body("crypto__...")].
  It is needed whenever the crate does so, and harmless otherwise.

  missingdecl.pvl, extracted next to this file, declares every symbol
  this file uses that none of these libraries defines, such as string
  literals and integer literals above 16. Each is left abstract:
  replace its declaration by a definition — by hand or from another
  crate's extraction — or keep it as an ideal-functionality boundary.
*)

(* Only typechecks with result.pvl loaded. *)
letfun hax_result_model_check__new_tests() = hax_result_model__result.

(*****************************************************************)
(*  WARNINGS — branches the model may not follow as Rust does.   *)
(*                                                               *)
(*  Each `HAX WARNING` below marks an `if` or `match` on a value *)
(*  the model cannot always evaluate. When it cannot, no arm of  *)
(*  a `match` is taken (the trace ends) and an `if` takes its    *)
(*  `else` branch, whatever Rust does. A query about the other   *)
(*  branch may then hold for lack of any trace.                  *)
(*                                                               *)
(*  - 1 × branch on an ordering comparison, which the model decides only between literals up to 16 *)
(*  - 1 × branch on a result of `core__cmp__Ord__cmp`, which the model does not define *)
(*  - 1 × branch on a result of `alloc__collections__vec_deque__Impl_5__contains`, which the model does not define *)
(*****************************************************************)

(* src: src/legacy/proverif-opaque-branches/lib.rs:11:0-13:1 new_tests__legacy__proverif_opaque_branches__lib__long_message *)
letfun new_tests__legacy__proverif_opaque_branches__lib__long_message(m: bitstring) =
  (* HAX WARNING: branch on an ordering comparison, which the model decides only between literals up to 16 *)
  let hax__cond0 = rust_primitives__hax__machine_int__gt(core__slice__Impl__len(m), nat_64) in
  let (=True()) = hax__cond0 in nat_1 else nat_0.
(* src: src/legacy/proverif-opaque-branches/lib.rs:16:0-22:1 new_tests__legacy__proverif_opaque_branches__lib__compare *)
letfun new_tests__legacy__proverif_opaque_branches__lib__compare(a: bitstring, b: bitstring) =
  (* HAX WARNING: branch on a result of `core__cmp__Ord__cmp`, which the model does not define *)
  let hax__scrut0 = core__cmp__Ord__cmp(a, b) in
  let core__cmp__Ordering__Less() = hax__scrut0 in nat_0
  else let core__cmp__Ordering__Equal() = hax__scrut0 in nat_1
  else let core__cmp__Ordering__Greater() = hax__scrut0 in nat_2
  else bitstring_err().
(* src: src/legacy/proverif-opaque-branches/lib.rs:25:0-27:1 new_tests__legacy__proverif_opaque_branches__lib__seen *)
letfun new_tests__legacy__proverif_opaque_branches__lib__seen(q: bitstring, x: bitstring) =
  (* HAX WARNING: branch on a result of `alloc__collections__vec_deque__Impl_5__contains`, which the model does not define *)
  let hax__cond0 = alloc__collections__vec_deque__Impl_5__contains(q, x) in
  let (=True()) = hax__cond0 in True() else False().
(* src: src/legacy/proverif-opaque-branches/lib.rs:30:0-32:1 new_tests__legacy__proverif_opaque_branches__lib__is_zero *)
letfun new_tests__legacy__proverif_opaque_branches__lib__is_zero(x: bitstring) =
  let hax__cond0 = rust_primitives__hax__machine_int__eq(x, nat_0) in
  let (=True()) = hax__cond0 in nat_1 else nat_0.
fun new_tests__legacy__proverif_opaque_branches__lib__parse(bitstring): bitstring [data].
(* src: src/legacy/proverif-opaque-branches/lib.rs:43:0-45:1 new_tests__legacy__proverif_opaque_branches__lib__uses_parse *)
letfun new_tests__legacy__proverif_opaque_branches__lib__uses_parse(x: bitstring) =
  let hax__cond0 = new_tests__legacy__proverif_opaque_branches__lib__parse(x) in
  let (=True()) = hax__cond0 in nat_1 else nat_0.
(* src: src/legacy/proverif-opaque-branches/lib.rs:50:0-52:1 new_tests__legacy__proverif_opaque_branches__lib__encode *)
(* marked as constructor *)
fun new_tests__legacy__proverif_opaque_branches__lib__encode(bitstring): bitstring [data].
reduc forall x: bitstring; new_tests__legacy__proverif_opaque_branches__lib__encode__inverse_decode(new_tests__legacy__proverif_opaque_branches__lib__encode(x)) = x.
(* src: src/legacy/proverif-opaque-branches/lib.rs:54:0-54:33 new_tests__legacy__proverif_opaque_branches__lib__decode *)
letfun new_tests__legacy__proverif_opaque_branches__lib__decode(x: bitstring) =
  new_tests__legacy__proverif_opaque_branches__lib__encode__inverse_decode(x).
(* src: src/legacy/proverif-opaque-branches/lib.rs:59:0-64:1 new_tests__legacy__proverif_opaque_branches__lib__round_trip *)
letfun new_tests__legacy__proverif_opaque_branches__lib__round_trip(x: bitstring) =
  let hax__scrut0 = new_tests__legacy__proverif_opaque_branches__lib__decode(
    new_tests__legacy__proverif_opaque_branches__lib__encode(x)
  ) in
  let Some(y) = hax__scrut0 in y
  else let None() = hax__scrut0 in nat_0
  else bitstring_err().