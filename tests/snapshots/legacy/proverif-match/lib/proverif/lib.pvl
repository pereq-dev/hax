(*
  Run with:
    proverif -lib <hax>/hax-lib/proof-libs/proverif/primitives.pvl \
             -lib <hax>/hax-lib/proof-libs/proverif/result.pvl \
             -lib <hax>/hax-lib/proof-libs/proverif/cryptolib.pvl  \
             -lib missingdecl.pvl \
             -lib lib.pvl your_analysis.pv

  These libraries ship with hax.

  primitives.pvl declares the symbols this file uses but does not
  define: the public channel c, the construct_fail sink,
  bitstring_default and bitstring_err, the Some/None and True/False
  constructors, the nat_0 to nat_16 literal constants, and the
  rust_primitives, core, and hax_lib helpers.

  result.pvl models Result and its methods.
  This model was extracted without --result-errors: a Result is its
  Ok payload and producing an Err ends the trace, so error paths are
  pruned from the model.

  cryptolib.pvl is the shared Dolev-Yao crypto model (hash, AEAD,
  KDF, DH, KEM, signatures, MAC, serialization) that a crate wires
  itself to with #[hax_lib::proverif::replace_body("crypto__...")].
  It is needed whenever the crate does so, and harmless otherwise.

  missingdecl.pvl, extracted next to this file, declares every symbol
  this file uses that none of these libraries defines, such as string
  literals and integer literals above 16. Each is left abstract:
  replace its declaration by a definition — by hand or from another
  crate's extraction — or keep it as an ideal-functionality boundary.
*)

(* Only typechecks with result.pvl loaded. *)
letfun hax_result_model_check__new_tests() = hax_result_model__result.

(* src: src/legacy/proverif-match/lib.rs:7:0-10:1 new_tests__legacy__proverif_match__lib__Direction *)
fun new_tests__legacy__proverif_match__lib__Direction__North(): bitstring [data].
fun new_tests__legacy__proverif_match__lib__Direction__South(): bitstring [data].
(* src: src/legacy/proverif-match/lib.rs:7:0-10:1 new_tests__legacy__proverif_match__lib__Direction_cast_to_repr *)
letfun new_tests__legacy__proverif_match__lib__Direction_cast_to_repr(x: bitstring) =
  let new_tests__legacy__proverif_match__lib__Direction__North() = x in nat_0
  else let new_tests__legacy__proverif_match__lib__Direction__South() = x in nat_1
  else bitstring_err().
(* src: src/legacy/proverif-match/lib.rs:12:0-17:1 new_tests__legacy__proverif_match__lib__opposite *)
letfun new_tests__legacy__proverif_match__lib__opposite(d: bitstring) =
  let new_tests__legacy__proverif_match__lib__Direction__North() = d in
    new_tests__legacy__proverif_match__lib__Direction__South()
  else let new_tests__legacy__proverif_match__lib__Direction__South() = d in
    new_tests__legacy__proverif_match__lib__Direction__North()
  else bitstring_err().
(* src: src/legacy/proverif-match/lib.rs:19:0-24:1 new_tests__legacy__proverif_match__lib__or_zero *)
letfun new_tests__legacy__proverif_match__lib__or_zero(x: bitstring) =
  let Some(v) = x in v
  else let None() = x in nat_0
  else bitstring_err().
(* src: src/legacy/proverif-match/lib.rs:26:0-26:12 new_tests__legacy__proverif_match__lib__Void *)

(* src: src/legacy/proverif-match/lib.rs:26:0-26:12 new_tests__legacy__proverif_match__lib__Void_cast_to_repr *)
letfun new_tests__legacy__proverif_match__lib__Void_cast_to_repr(x: bitstring) = bitstring_err().
(* src: src/legacy/proverif-match/lib.rs:28:0-30:1 new_tests__legacy__proverif_match__lib__absurd *)
letfun new_tests__legacy__proverif_match__lib__absurd(v: bitstring) = bitstring_err().