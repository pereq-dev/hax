(*
  Run with:
    proverif -lib <hax>/hax-lib/proof-libs/proverif/primitives.pvl \
             -lib <hax>/hax-lib/proof-libs/proverif/result.pvl \
             -lib <hax>/hax-lib/proof-libs/proverif/cryptolib.pvl  \
             -lib missingdecl.pvl \
             -lib lib.pvl your_analysis.pv

  These libraries ship with hax.

  primitives.pvl declares the symbols this file uses but does not
  define: the public channel c, the construct_fail sink,
  bitstring_default and bitstring_err, the Some/None and True/False
  constructors, the nat_0 to nat_16 literal constants, and the
  rust_primitives, core, and hax_lib helpers.

  result.pvl models Result and its methods.
  This model was extracted without --result-errors: a Result is its
  Ok payload and producing an Err ends the trace, so error paths are
  pruned from the model.

  cryptolib.pvl is the shared Dolev-Yao crypto model (hash, AEAD,
  KDF, DH, KEM, signatures, MAC, serialization) that a crate wires
  itself to with #[hax_lib::proverif::replace_body("crypto__...")].
  It is needed whenever the crate does so, and harmless otherwise.

  missingdecl.pvl, extracted next to this file, declares every symbol
  this file uses that none of these libraries defines, such as string
  literals and integer literals above 16. Each is left abstract:
  replace its declaration by a definition — by hand or from another
  crate's extraction — or keep it as an ideal-functionality boundary.
*)

(* Only typechecks with result.pvl loaded. *)
letfun hax_result_model_check__new_tests() = hax_result_model__result.

(*****************************************************************)
(*  WARNINGS — branches the model may not follow as Rust does.   *)
(*                                                               *)
(*  Each `HAX WARNING` below marks an `if` or `match` on a value *)
(*  the model cannot always evaluate. When it cannot, no arm of  *)
(*  a `match` is taken (the trace ends) and an `if` takes its    *)
(*  `else` branch, whatever Rust does. A query about the other   *)
(*  branch may then hold for lack of any trace.                  *)
(*                                                               *)
(*  - 1 × `replace_body` keeps the `&mut` parameters `self` unchanged *)
(*****************************************************************)

(* src: src/legacy/proverif-replace-body/lib.rs:5:0-5:19 new_tests__legacy__proverif_replace_body__lib__Counter *)
fun new_tests__legacy__proverif_replace_body__lib__Counter__Counter(bitstring): bitstring [data].
reduc forall v_0: bitstring;
  new_tests__legacy__proverif_replace_body__lib__Counter__Counter__0(
    new_tests__legacy__proverif_replace_body__lib__Counter__Counter(v_0)
  ) = v_0.
(* src: src/legacy/proverif-replace-body/lib.rs:9:4-9:47 new_tests__legacy__proverif_replace_body__lib__Impl__zero *)
letfun new_tests__legacy__proverif_replace_body__lib__Impl__zero(self: bitstring) = nat_0.
(* src: src/legacy/proverif-replace-body/lib.rs:16:4-16:46 new_tests__legacy__proverif_replace_body__lib__Impl__bump *)
(* HAX WARNING: `replace_body` keeps the `&mut` parameters `self` unchanged *)
letfun new_tests__legacy__proverif_replace_body__lib__Impl__bump(self: bitstring) =
  let wildcard = (self) in
  self.
(* src: src/legacy/proverif-replace-body/lib.rs:22:0-25:1 new_tests__legacy__proverif_replace_body__lib__use_bump *)
letfun new_tests__legacy__proverif_replace_body__lib__use_bump(c: bitstring) =
  new_tests__legacy__proverif_replace_body__lib__Impl__bump(c).
letfun model(x: bitstring) = x.
(* src: src/legacy/proverif-replace-body/lib.rs:29:0-29:46 new_tests__legacy__proverif_replace_body__lib__uses *)
letfun new_tests__legacy__proverif_replace_body__lib__uses(x: bitstring) = model(x).
(* src: src/legacy/proverif-replace-body/lib.rs:35:0-35:16 new_tests__legacy__proverif_replace_body__lib__declares *)
letfun new_tests__legacy__proverif_replace_body__lib__declares(wildcard: bitstring) =
  rust_primitives__hax__Tuple0__Tuple0.
letfun new_tests__legacy__proverif_replace_body__lib__replaced(x: bitstring) = x.
(* src: src/legacy/proverif-replace-body/lib.rs:45:0-47:1 new_tests__legacy__proverif_replace_body__lib__uses_replaced *)
letfun new_tests__legacy__proverif_replace_body__lib__uses_replaced(x: bitstring) =
