(* marked as constructor *)
fun new_tests__legacy__proverif_replace_body__lib__pack(bitstring): bitstring [data].
reduc forall x: bitstring; new_tests__legacy__proverif_replace_body__lib__unpack__inverse(new_tests__legacy__proverif_replace_body__lib__pack(x)) = x.
