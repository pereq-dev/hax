fun new_tests__legacy__proverif_excluded_impls__lib__Counter__Counter(bitstring): bitstring [data].
reduc forall v_0: bitstring;
  new_tests__legacy__proverif_excluded_impls__lib__Counter__Counter__0(
    new_tests__legacy__proverif_excluded_impls__lib__Counter__Counter(v_0)
  ) = v_0.
