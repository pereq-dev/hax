(*
  Run with:
    proverif -lib <hax>/hax-lib/proof-libs/proverif/primitives.pvl \
             -lib <hax>/hax-lib/proof-libs/proverif/result.pvl \
             -lib <hax>/hax-lib/proof-libs/proverif/cryptolib.pvl  \
             -lib missingdecl.pvl \
             -lib lib.pvl your_analysis.pv

  These libraries ship with hax.

  primitives.pvl declares the symbols this file uses but does not
  define: the public channel c, the construct_fail sink,
  bitstring_default and bitstring_err, the Some/None and True/False
  constructors, the nat_0 to nat_16 literal constants, and the
  rust_primitives, core, and hax_lib helpers.

  result.pvl models Result and its methods.
  This model was extracted without --result-errors: a Result is its
  Ok payload and producing an Err ends the trace, so error paths are
  pruned from the model.

  cryptolib.pvl is the shared Dolev-Yao crypto model (hash, AEAD,
  KDF, DH, KEM, signatures, MAC, serialization) that a crate wires
  itself to with #[hax_lib::proverif::replace_body("crypto__...")].
  It is needed whenever the crate does so, and harmless otherwise.

  missingdecl.pvl, extracted next to this file, declares every symbol
  this file uses that none of these libraries defines, such as string
  literals and integer literals above 16. Each is left abstract:
  replace its declaration by a definition — by hand or from another
  crate's extraction — or keep it as an ideal-functionality boundary.
*)

(* Only typechecks with result.pvl loaded. *)
letfun hax_result_model_check__new_tests() = hax_result_model__result.

(*****************************************************************)
(*  WARNINGS — branches the model may not follow as Rust does.   *)
(*                                                               *)
(*  Each `HAX WARNING` below marks an `if` or `match` on a value *)
(*  the model cannot always evaluate. When it cannot, no arm of  *)
(*  a `match` is taken (the trace ends) and an `if` takes its    *)
(*  `else` branch, whatever Rust does. A query about the other   *)
(*  branch may then hold for lack of any trace.                  *)
(*                                                               *)
(*  - 1 × branch on an ordering comparison, which the model decides only between literals up to 16 *)
(*  - 1 × `size_of` or `align_of` modelled without its type argument, so that it is the same for every type *)
(*****************************************************************)

(* src: src/rustc-coverage/branch/generics.rs:7:0-13:1 new_tests__rustc_coverage__branch__generics__print_size *)
letfun new_tests__rustc_coverage__branch__generics__print_size(wildcard: bitstring) =
  (* HAX WARNING: branch on an ordering comparison, which the model decides only between literals up to 16 *)
  let hax__cond0 = rust_primitives__hax__machine_int__gt(
    (* HAX WARNING: `size_of` or `align_of` modelled without its type argument, so that it is the same for every type *) core__mem__size_of(
      rust_primitives__hax__Tuple0__Tuple0
    ),
    nat_4
  ) in
  let (=True()) = hax__cond0
    in (let wildcard_1 = std__io__stdio__u_print(
      core__fmt__rt__Impl_1__new_const(
        rust_primitives__hax__array_cons(string_lit__size_x20_x3e_x204_x0a, rust_primitives__hax__array_nil())
      )
    ) in
    let wildcard_2 = rust_primitives__hax__Tuple0__Tuple0 in
    rust_primitives__hax__Tuple0__Tuple0)
    else (let wildcard_3 = std__io__stdio__u_print(
      core__fmt__rt__Impl_1__new_const(
        rust_primitives__hax__array_cons(string_lit__size_x20_x3c_x3d_x204_x0a, rust_primitives__hax__array_nil())
      )
    ) in
    let wildcard_4 = rust_primitives__hax__Tuple0__Tuple0 in
    rust_primitives__hax__Tuple0__Tuple0).
(* src: src/rustc-coverage/branch/generics.rs:16:0-20:1 new_tests__rustc_coverage__branch__generics__main *)
letfun new_tests__rustc_coverage__branch__generics__main(wildcard: bitstring) =
  let wildcard_1 = new_tests__rustc_coverage__branch__generics__print_size(
    rust_primitives__hax__Tuple0__Tuple0
  ) in
  let wildcard_2 = new_tests__rustc_coverage__branch__generics__print_size(
    rust_primitives__hax__Tuple0__Tuple0
  ) in
  let wildcard_3 = new_tests__rustc_coverage__branch__generics__print_size(
    rust_primitives__hax__Tuple0__Tuple0
  ) in
  rust_primitives__hax__Tuple0__Tuple0.