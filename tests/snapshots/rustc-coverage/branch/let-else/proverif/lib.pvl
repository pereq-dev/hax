letfun new_tests__rustc_coverage__branch__let_else__let_else(value: bitstring) =
  let wildcard = ((let bl__seq0 = (core__iter__traits__collect__IntoIterator__into_iter(
    core__ops__range__Range__Range(nat_0, nat_1)
  )) in 
  let rust_primitives__hax__array_cons(wildcard_1, bl__seq1) = bl__seq0 in (let bl__unit0 = (rust_primitives__hax__Tuple0__Tuple0) in
  let rust_primitives__hax__array_cons(wildcard_1, bl__seq2) = bl__seq1 in (let bl__unit1 = (rust_primitives__hax__Tuple0__Tuple0) in
  let rust_primitives__hax__array_cons(wildcard_1, bl__seq3) = bl__seq2 in (let bl__unit2 = (rust_primitives__hax__Tuple0__Tuple0) in
  rust_primitives__hax__Tuple0__Tuple0 (* more than LOOP_BOUND elements *)) else (rust_primitives__hax__Tuple0__Tuple0)) else (rust_primitives__hax__Tuple0__Tuple0)) else (rust_primitives__hax__Tuple0__Tuple0))) in
  let Some(x) = value in
    (let wildcard_2 = new_tests__rustc_coverage__branch__let_else__say(x) in
    rust_primitives__hax__Tuple0__Tuple0)
  else let wildcard_3 = new_tests__rustc_coverage__branch__let_else__say(string_lit__none) in
  rust_primitives__hax__Tuple0__Tuple0.
(* src: src/rustc-coverage/branch/let-else.rs:30:0-34:1 new_tests__rustc_coverage__branch__let_else__main *)
letfun new_tests__rustc_coverage__branch__let_else__main(wildcard: bitstring) =
  let wildcard_1 = new_tests__rustc_coverage__branch__let_else__let_else(Some(string_lit__x)) in
  let wildcard_2 = new_tests__rustc_coverage__branch__let_else__let_else(Some(string_lit__x)) in
  let wildcard_3 = new_tests__rustc_coverage__branch__let_else__let_else(None()) in
  rust_primitives__hax__Tuple0__Tuple0.