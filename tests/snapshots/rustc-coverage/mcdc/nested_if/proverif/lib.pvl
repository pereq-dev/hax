letfun new_tests__rustc_coverage__mcdc__nested_if__say(message: bitstring) =
  let wildcard = core__hint__black_box(message) in
  rust_primitives__hax__Tuple0__Tuple0.
(* src: src/rustc-coverage/mcdc/nested_if.rs:6:0-12:1 new_tests__rustc_coverage__mcdc__nested_if__nested_if_in_condition *)
letfun new_tests__rustc_coverage__mcdc__nested_if__nested_if_in_condition(
  a: bitstring,
  b: bitstring,
  c: bitstring
) =
  let hax__cond0 = (let (=True()) = a
    in (let hax__cond1 = (let (=True()) = b
      in True()
      else let (=False()) = b
      in c
      else logical_or_opaque(b)) in
    let (=True()) = hax__cond1 in True() else False())
    else let (=False()) = a
    in False()
    else logical_and_opaque(a)) in
  let (=True()) = hax__cond0
    in (let wildcard = new_tests__rustc_coverage__mcdc__nested_if__say(string_lit__yes) in
    rust_primitives__hax__Tuple0__Tuple0)
    else (let wildcard_1 = new_tests__rustc_coverage__mcdc__nested_if__say(string_lit__no) in
    rust_primitives__hax__Tuple0__Tuple0).
