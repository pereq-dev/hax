  let wildcard_10 = new_tests__rustc_coverage__mcdc__if__mcdc_check_tree_decision(
    False(),
    True(),
    True()
  ) in
  let wildcard_11 = new_tests__rustc_coverage__mcdc__if__mcdc_check_tree_decision(
