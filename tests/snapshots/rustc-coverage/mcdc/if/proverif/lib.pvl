    True(),
    False()
  ) in
  let wildcard_12 = new_tests__rustc_coverage__mcdc__if__mcdc_check_tree_decision(
    True(),
    False(),
    False()
  ) in
  let wildcard_13 = new_tests__rustc_coverage__mcdc__if__mcdc_check_tree_decision(
    True(),
    False(),
    True()
  ) in
  let wildcard_14 = new_tests__rustc_coverage__mcdc__if__mcdc_check_not_tree_decision(
    False(),
    True(),
    True()
  ) in
  let wildcard_15 = new_tests__rustc_coverage__mcdc__if__mcdc_check_not_tree_decision(
    True(),
    True(),
    False()
  ) in
  let wildcard_16 = new_tests__rustc_coverage__mcdc__if__mcdc_check_not_tree_decision(
    True(),
    False(),
    False()
  ) in
  let wildcard_17 = new_tests__rustc_coverage__mcdc__if__mcdc_check_not_tree_decision(
