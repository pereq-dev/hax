  a: bitstring,
  b: bitstring,
  c: bitstring
) =
  let hax__cond0 = (let (=True()) = a
    in (let (=True()) = b in True() else let (=False()) = b in c else logical_or_opaque(b))
    else let (=False()) = a
    in False()
    else logical_and_opaque(a)) in
