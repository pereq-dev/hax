  c: bitstring
) =
  let hax__cond0 = (let (=True()) = a
    in True()
    else let (=False()) = a
    in b
    else logical_or_opaque(a)) in
  let (=True()) = hax__cond0
    in (let wildcard = new_tests__rustc_coverage__mcdc__if__say(string_lit__a_x20or_x20b) in
