(*****************************************************************)
(*  hax — ProVerif Result library: the `--result-errors` model   *)
(*****************************************************************)
(* Load this file right after `primitives.pvl` for a model        *)
(* extracted WITH `--result-errors`; `result.pvl` is the library  *)
(* for the default mode.                                          *)
(*                                                                *)
(* `Ok` and `Err` are data constructors, and the backend keeps    *)
(* every match arm, so error paths stay reachable. A value that   *)
(* reaches a `Result` method or pattern must therefore be built   *)
(* with one of them: an opaque symbol standing for a function     *)
(* that returns a `Result` matches neither, so `unwrap` fails and *)
(* a `match` on it takes no arm.                                  *)
(*****************************************************************)

(* Named by the extracted `lib.pvl`, so that it only loads with this file. *)
const hax_result_model__result_errors: bitstring.

fun core__result__Result__Ok(bitstring): bitstring [data].
fun core__result__Result__Err(bitstring): bitstring [data].

(* `Ok(x)` and `Err(e)` for a hand-written model of a function returning a
   `Result` (e.g. a `replace_body`); both Result libraries define them. *)
letfun hax_result_ok(x: bitstring) = core__result__Result__Ok(x).
letfun hax_result_err(e: bitstring) = core__result__Result__Err(e).

letfun core__result__Impl__unwrap(r: bitstring) =
  let core__result__Result__Ok(x) = r in x else bitstring_err().
letfun core__result__Impl__expect(r: bitstring, m: bitstring) =
  let core__result__Result__Ok(x) = r in x else bitstring_err().
letfun core__result__Impl__unwrap_err(r: bitstring) =
  let core__result__Result__Err(e) = r in e else bitstring_err().
letfun core__result__Impl__expect_err(r: bitstring, m: bitstring) =
  let core__result__Result__Err(e) = r in e else bitstring_err().
letfun core__result__Impl__unwrap_or(r: bitstring, d: bitstring) =
  let core__result__Result__Ok(x) = r in x
  else let core__result__Result__Err(e) = r in d
  else bitstring_err().
letfun core__result__Impl__is_ok(r: bitstring) =
  let core__result__Result__Ok(x) = r in True()
  else let core__result__Result__Err(e) = r in False()
  else bitstring_err().
letfun core__result__Impl__is_err(r: bitstring) =
  let core__result__Result__Ok(x) = r in False()
  else let core__result__Result__Err(e) = r in True()
  else bitstring_err().
letfun core__result__Impl__ok(r: bitstring) =
  let core__result__Result__Ok(x) = r in Some(x)
  else let core__result__Result__Err(e) = r in None()
  else bitstring_err().
letfun core__result__Impl__err(r: bitstring) =
  let core__result__Result__Err(e) = r in Some(e)
  else let core__result__Result__Ok(x) = r in None()
  else bitstring_err().
(* The closure is opaque, so the mapped payload is too; an `Err` is kept. *)
fun hax_result_map_ok(bitstring, bitstring): bitstring [data].
letfun core__result__Impl__map(r: bitstring, f: bitstring) =
  let core__result__Result__Ok(x) = r in core__result__Result__Ok(hax_result_map_ok(x, f))
  else let core__result__Result__Err(e) = r in r
  else bitstring_err().
fun hax_result_map_err(bitstring, bitstring): bitstring [data].
letfun core__result__Impl__map_err(r: bitstring, f: bitstring) =
  let core__result__Result__Ok(x) = r in r
  else let core__result__Result__Err(e) = r in core__result__Result__Err(hax_result_map_err(e, f))
  else bitstring_err().
fun hax_result_unwrap_or_else(bitstring, bitstring): bitstring [data].
letfun core__result__Impl__unwrap_or_else(r: bitstring, f: bitstring) =
  let core__result__Result__Ok(x) = r in x
  else let core__result__Result__Err(e) = r in hax_result_unwrap_or_else(e, f)
  else bitstring_err().

(* An unknown Option (see `unwrap` in `primitives.pvl`) is read as `Some`,
   so its `Err` path is not explored. *)
letfun core__option__Impl__ok_or(o: bitstring, e: bitstring) =
  let Some(x) = o in core__result__Result__Ok(x)
  else let None() = o in core__result__Result__Err(e)
  else core__result__Result__Ok(hax_option_payload(o)).

(* Conversions are identity on the payload (see `From::from` in
   `primitives.pvl`) and never fail. *)
(* `Option<Result<T, E>>::transpose`. The impl number is the pinned
   toolchain's; the `proverif-result-errors` test calls it. *)
fun hax_transpose_opaque(bitstring): bitstring [data].
letfun core__option__Impl_4__transpose(o: bitstring) =
  let None() = o in core__result__Result__Ok(None())
  else let Some(r) = o in
    (let core__result__Result__Ok(x) = r in core__result__Result__Ok(Some(x))
     else let core__result__Result__Err(e) = r in core__result__Result__Err(e)
     else hax_transpose_opaque(o))
  else hax_transpose_opaque(o).
letfun core__convert__TryInto__try_into(x: bitstring) = core__result__Result__Ok(x).
letfun core__convert__TryFrom__try_from(x: bitstring) = core__result__Result__Ok(x).

(* Fresh randomness, as `RngCore::fill_bytes` in `primitives.pvl`; the
   `Result` makes the call return `(rng, dest, Ok(()))`. *)
letfun rand_core__TryRngCore__try_fill_bytes(rng: bitstring, dest: bitstring) =
  new b: bitstring;
  rust_primitives__hax__Tuple3__Tuple3(rng, b, core__result__Result__Ok(rust_primitives__hax__Tuple0__Tuple0)).
