  let rust_primitives__hax__array_nil() = v in True()
  else let rust_primitives__hax__array_cons(x, r) = v in False()
  else hax_seq_is_empty(v).
letfun core__slice__Impl__is_empty(v: bitstring) = alloc__vec__Impl_1__is_empty(v).
fun alloc__vec__from_elem(bitstring, bitstring): bitstring [data].
(* `push` APPENDS. The Seq is head-first — an array literal `[a, b, c]` is
   `array_cons(a, array_cons(b, array_cons(c, array_nil())))` and
   `Index::index(v, nat_0)` returns the head — so a prepending push would make
   `v[0]` the FIRST element of a literal but the LAST pushed element of a built
   Vec, i.e. the same accessor meaning opposite things depending on the Vec's
   provenance. `array_extend` does the bounded append (and degrades to the
   opaque `array_concat` past the bound, like every other Seq operation). *)
letfun alloc__vec__Impl_1__push(s: bitstring, x: bitstring) =
  array_extend(s, rust_primitives__hax__array_cons(x, rust_primitives__hax__array_nil())).
(* `a.append(&mut b)` moves `b`'s elements into `a` and leaves `b` empty; both
   are `&mut`, so the call returns the pair. *)
letfun alloc__vec__Impl_1__append(a: bitstring, b: bitstring) =
  rust_primitives__hax__Tuple2__Tuple2(array_extend(a, b), rust_primitives__hax__array_nil()).
(* Every `len` is the same function of the Seq, so `v.len()` and
   `v.as_slice().len()` agree. Exact up to the unroll bound, opaque past it and
   on a byte blob. *)
fun hax_seq_len(bitstring): bitstring [data].
letfun core__slice__Impl__len(s: bitstring) =
  let rust_primitives__hax__array_nil() = s in nat_0
  else let rust_primitives__hax__array_cons(x0, r0) = s in
    (let rust_primitives__hax__array_nil() = r0 in nat_1
     else let rust_primitives__hax__array_cons(x1, r1) = r0 in
       (let rust_primitives__hax__array_nil() = r1 in nat_2
        else let rust_primitives__hax__array_cons(x2, r2) = r1 in
          (let rust_primitives__hax__array_nil() = r2 in nat_3
           else hax_seq_len(s))
        else hax_seq_len(s))
     else hax_seq_len(s))
  else hax_seq_len(s).
letfun alloc__vec__Impl_1__len(s: bitstring) = core__slice__Impl__len(s).
letfun rust_primitives__slice__len(s: bitstring) = core__slice__Impl__len(s).
letfun rust_primitives__sequence__seq_len(s: bitstring) = core__slice__Impl__len(s).
letfun core__iter__traits__exact_size__ExactSizeIterator__len(s: bitstring) = core__slice__Impl__len(s).
(* `last()` walks to the end of the head-first Seq, bounded like every other
   unrolled Seq operation, and degrades to an opaque accessor for a byte blob
   or a longer list. Returns `Option<&T>`, hence `Some`/`None`. *)
fun core__slice__Impl__last_opaque(bitstring): bitstring [data].
letfun core__slice__Impl__last(s: bitstring) =
  let rust_primitives__hax__array_nil() = s in None()
  else let rust_primitives__hax__array_cons(x0, r0) = s in
    (let rust_primitives__hax__array_nil() = r0 in Some(x0)
     else let rust_primitives__hax__array_cons(x1, r1) = r0 in
       (let rust_primitives__hax__array_nil() = r1 in Some(x1)
        else let rust_primitives__hax__array_cons(x2, r2) = r1 in
          (let rust_primitives__hax__array_nil() = r2 in Some(x2)
           else core__slice__Impl__last_opaque(s))
        else core__slice__Impl__last_opaque(s))
     else core__slice__Impl__last_opaque(s))
  else core__slice__Impl__last_opaque(s).
(* `s[0]` -> head, `s[1..]` -> tail; other indices / opaque (byte-buffer)      *)
(* operands fall back to an opaque accessor. *)
letfun core__ops__index__Index__index(s: bitstring, pos: bitstring) =
  let (= nat_0) = pos in
    (let rust_primitives__hax__array_cons(x, r) = s in x else array_index_opaque(s, pos))
  else let (= core__ops__range__RangeFrom__RangeFrom(nat_1)) = pos in
    (let rust_primitives__hax__array_cons(x, r) = s in r else array_index_opaque(s, pos))
  (* A slice of a concatenation `a ++ b` stays opaque: the model has no
     lengths, so `s[..n]` cannot tell which bytes of `a` and `b` it covers. *)
  else array_index_opaque(s, pos).
(* `s[i] = v` and `s[r] = v`. Replacing the head, or the whole of `s`, is
   exact; any other position or range is an opaque update of `s`. *)
fun hax_update_at_opaque(bitstring, bitstring, bitstring): bitstring [data].
letfun rust_primitives__hax__monomorphized_update_at__update_at_usize(
  s: bitstring, i: bitstring, v: bitstring
) =
  let (= nat_0) = i in
    (let rust_primitives__hax__array_cons(x, r) = s in rust_primitives__hax__array_cons(v, r)
     else hax_update_at_opaque(s, i, v))
  else hax_update_at_opaque(s, i, v).
letfun rust_primitives__hax__monomorphized_update_at__update_at_range(
  s: bitstring, r: bitstring, v: bitstring
) = hax_update_at_opaque(s, r, v).
letfun rust_primitives__hax__monomorphized_update_at__update_at_range_from(
  s: bitstring, r: bitstring, v: bitstring
) = hax_update_at_opaque(s, r, v).
letfun rust_primitives__hax__monomorphized_update_at__update_at_range_to(
  s: bitstring, r: bitstring, v: bitstring
) = hax_update_at_opaque(s, r, v).
letfun rust_primitives__hax__monomorphized_update_at__update_at_range_full(
  s: bitstring, r: bitstring, v: bitstring
) = v.
(* `dst.copy_from_slice(src)` overwrites `dst` with `src`: the `&mut self`
   output becomes `src`. Used to thread a decrypted plaintext into a `&mut`
   output buffer (e.g. `decrypt_aesgcm256`). On a sub-range,
   `dst[..n].copy_from_slice(src)`, the result is written back into `dst` by
   `update_at_range_to` above, an opaque update. Rust's equal-length
   precondition is not modelled. *)
letfun core__slice__Impl__copy_from_slice(self: bitstring, src: bitstring) = src.
letfun core__slice__Impl__clone_from_slice(self: bitstring, src: bitstring) = src.

(*****************************************************************)
(*  More std prelude. Same conventions: ADT variants are `[data]`, *)
(*  Option methods follow the structural model above, byte<->int   *)
(*  conversions are identity, and the remaining Vec/slice ops are  *)
(*  Seq stubs.                                                     *)
(*****************************************************************)

(*** core::ops::ControlFlow — an ADT that survives some folds; pattern- ***)
(*** matched in bodies, so it must be `[data]`.                          ***)
fun core__ops__control_flow__ControlFlow__Break(bitstring): bitstring [data].
fun core__ops__control_flow__ControlFlow__Continue(bitstring): bitstring [data].

(*** core::num — byte<->int conversions. An integer IS its big-endian bytes;  ***)
(*** the little-endian bytes are a distinct, invertible encoding of it. The   ***)
(*** impl numbers are those of the pinned toolchain; the                      ***)
(*** `proverif-int-conversions` test calls every one of them.               ***)
fun hax_le_bytes(bitstring): bitstring [data].
fun hax_from_le_bytes_opaque(bitstring): bitstring [data].
letfun hax_from_le_bytes(b: bitstring) =
  let hax_le_bytes(x) = b in x else hax_from_le_bytes_opaque(b).
