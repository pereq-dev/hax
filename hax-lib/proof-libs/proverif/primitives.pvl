(*** Option<T> methods, over the `Some`/`None` constructors above.        ***)
(* `unwrap`/`expect` on `None` is a panic -> `bitstring_err()` kills the    *)
(* trace; `is_some`/`is_none` branch; `as_ref`/`cloned` are identity.       *)
(* An Option that is neither `Some` nor `None` (the result of an opaque     *)
(* function) is unknown: its payload and `is_some` stay opaque, rather than *)
(* reading it as `None` and killing every trace that unwraps it.            *)
fun hax_option_payload(bitstring): bitstring [data].
fun hax_option_is_some(bitstring): bitstring [data].
fun hax_option_unwrap_or(bitstring, bitstring): bitstring [data].
letfun core__option__Impl__unwrap(o: bitstring) =
  let Some(x) = o in x
  else let None() = o in bitstring_err()
  else hax_option_payload(o).
letfun core__option__Impl__expect(o: bitstring, m: bitstring) =
  core__option__Impl__unwrap(o).
letfun core__option__Impl__is_some(o: bitstring) =
  let Some(x) = o in True()
  else let None() = o in False()
  else hax_option_is_some(o).
letfun core__option__Impl__is_none(o: bitstring) =
  core__ops__bit__Not__not_kw(core__option__Impl__is_some(o)).
letfun core__option__Impl__as_ref(o: bitstring) = o.
letfun core__option__Impl_2__cloned(o: bitstring) = o.
(* Never printed: bodies use the short `Some`/`None`. Declared so that the
   backend, which records the full paths as referenced, does not re-declare
   them in `missingdecl.pvl`. *)
fun core__option__Option__Some(bitstring): bitstring [data].
const core__option__Option__None: bitstring.

(*** core::clone — identity at the symbolic level ***)
letfun core__clone__Clone__clone(x: bitstring) = x.

(*** alloc::string / slice — String is its bytes; these are identity ***)
letfun alloc__string__Impl__as_bytes(x: bitstring) = x.
letfun alloc__string__Impl__into_bytes(x: bitstring) = x.
letfun alloc__string__ToString__to_string(x: bitstring) = x.
letfun alloc__slice__Impl__into_vec(x: bitstring) = x.
(* NOT the identity: `sort` permutes and `join` concatenates, and the Seq model
   IS order-sensitive (`Index::index(s, nat_0)` is the head). An identity here
   would be a false equation — `sort(v)[0]` would give `v`'s first element
   instead of its minimum, and `join(v, sep)` a list of lists instead of bytes.
   Opaque is the honest model: unknown, rather than knowably wrong. *)
fun alloc__slice__Impl__sort(bitstring): bitstring [data].
fun alloc__slice__Impl__join(bitstring, bitstring): bitstring [data].
letfun core__hint__must_use(x: bitstring) = x.
letfun hex__encode(x: bitstring) = x.                    (* bytes <-> hex string, same symbol *)

(* Serialization of two fields as one opaque, injective, NON-destructurable
   term. Use it where a multi-field serialization is hashed or signed and never
   re-parsed: unlike `array_concat` above it gives the attacker no projections,
   so the encoding can only be built by someone who holds both fields. Both
   symbols are injective (a plain ProVerif `fun` is a free constructor); the
   difference is that this one is one-way. *)
fun serialize_fields2(bitstring, bitstring): bitstring.

(*** Iterators: the iterator IS the underlying cons-list, so `collect` is the ***)
(*** identity and `extend` is Seq append. `rev` is NOT the identity — the Seq  ***)
(*** is head-first and indexed, so reversing changes what `v[0]` is; it gets   ***)
(*** the bounded reversal, degrading to opaque past the unroll bound.          ***)
letfun core__iter__traits__iterator__Iterator__collect(x: bitstring) = x.
fun core__iter__traits__iterator__Iterator__rev_opaque(bitstring): bitstring [data].
letfun core__iter__traits__iterator__Iterator__rev(s: bitstring) =
  let rust_primitives__hax__array_nil() = s in s
  else let rust_primitives__hax__array_cons(x0, r0) = s in
    (let rust_primitives__hax__array_nil() = r0 in s
     else let rust_primitives__hax__array_cons(x1, r1) = r0 in
       (let rust_primitives__hax__array_nil() = r1 in
          rust_primitives__hax__array_cons(x1, rust_primitives__hax__array_cons(x0, rust_primitives__hax__array_nil()))
        else let rust_primitives__hax__array_cons(x2, r2) = r1 in
          (let rust_primitives__hax__array_nil() = r2 in
             rust_primitives__hax__array_cons(x2, rust_primitives__hax__array_cons(x1, rust_primitives__hax__array_cons(x0, rust_primitives__hax__array_nil())))
           else core__iter__traits__iterator__Iterator__rev_opaque(s))
        else core__iter__traits__iterator__Iterator__rev_opaque(s))
     else core__iter__traits__iterator__Iterator__rev_opaque(s))
  else core__iter__traits__iterator__Iterator__rev_opaque(s).
letfun core__iter__traits__collect__Extend__extend(a: bitstring, b: bitstring) = array_extend(a, b).


(*** Panics kill the trace (an unreachable path in a sound model). ***)
letfun core__panicking__panic(x: bitstring) = bitstring_err().
letfun core__panicking__panic_fmt(x: bitstring) = bitstring_err().
letfun core__panicking__assert_failed(a: bitstring, b: bitstring, c: bitstring, d: bitstring) = bitstring_err().
const core__panicking__AssertKind__Eq: bitstring.

